{
  "name": "@talentia/bootstrap",
  "description": "The most popular front-end framework for developing responsive, mobile first projects on the web.",
  "version": "4.7.0",
  "keywords": [
    "css",
    "sass",
    "mobile-first",
    "responsive",
    "front-end",
    "framework",
    "web"
  ],
  "author": {
    "name": "Leonardo Cavone",
    "url": "https://github.com/Talentia-Software-OSS"
  },
  "homepage": "https://github.com/Talentia-Software-OSS/bootstrap",
  "repository": {
    "type": "git",
    "url": "https://github.com/Talentia-Software-OSS/bootstrap.git"
  },
  "bugs": {
    "url": "https://github.com/Talentia-Software-OSS/bootstrap/issues"
  },
  "contributors": [
    "Twitter, Inc.",
    "The Bootstrap Authors (https://github.com/twbs/bootstrap/graphs/contributors)"
  ],
  "license": "MIT",
  "licenseFilename": "LICENSE",
  "type": "module",
  "scripts": {
    "demo": "npm run build:dev && http-server . -c-1 -o demo/index.html",
    "watch": "run-s clean-publish && run-p watch:js watch:css",
    "watch:js": "nodemon --watch vendors/custom/js/**/* --ext js --exec \"npm run js-build:dev\"",
    "watch:css": "nodemon --watch vendors/custom/scss/**/* --ext scss --exec \"npm run css-build:dev\"",
    "build:prod": "run-s clean-publish copy-source && run-p css-build:prod js-build:prod",
    "build:dev": "run-s clean-publish && run-p css-build:dev js-build:dev",
    "css-build:prod": "run-s css-compile css-prefix css-minify",
    "css-build:dev": "run-s css-compile css-prefix",
    "css-compile": "sass --style expanded --source-map --embed-sources --no-error-css --no-charset vendors/custom/scss/:publish/dist/css/",
    "css-prefix": "postcss --replace publish/dist/css/*.css",
    "css-minify": "cleancss -O1 --format breakWith=lf --with-rebase --source-map --source-map-inline-sources --output publish/dist/css/ --batch --batch-suffix \".min\" \"publish/dist/css/*.css\" \"!publish/dist/css/*.min.css\"",
    "js-build:prod": "run-s js-compile js-minify",
    "js-build:dev": "run-s js-compile",
    "js-compile": "run-p js-compile-*",
    "js-compile-standalone": "rollup --environment BUNDLE:false --config rollup.config.js",
    "js-compile-bundle": "rollup --environment BUNDLE:true --config rollup.config.js",
    "js-minify": "run-p js-minify-*",
    "js-minify-standalone": "terser --compress passes=2,typeofs=false --mangle --comments \"/^!/\" --source-map \"content=publish/dist/js/bootstrap.js.map,includeSources,url=bootstrap.min.js.map\" --output publish/dist/js/bootstrap.min.js publish/dist/js/bootstrap.js",
    "js-minify-bundle": "terser --compress passes=2,typeofs=false --mangle --comments \"/^!/\" --source-map \"content=publish/dist/js/bootstrap.bundle.js.map,includeSources,url=bootstrap.bundle.min.js.map\" --output publish/dist/js/bootstrap.bundle.min.js publish/dist/js/bootstrap.bundle.js",
    "clean-publish": "rimraf publish",
    "copy-source": "run-p copy-scss-source copy-js-source copy-pkg-source",
    "copy-scss-source": "copyfiles -u 2 \"vendors/custom/scss/**/*\" publish",
    "copy-js-source": "copyfiles -u 2 \"vendors/custom/js/**/*\" publish",
    "copy-pkg-source": "copyfiles LICENSE package.json README publish"
  },
  "peerDependencies": {
    "jquery": "1.9.1 - 3",
    "popper.js": "1.16.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@rollup/plugin-babel": "6.1.0",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "autoprefixer": "10.4.23",
    "clean-css-cli": "5.6.3",
    "copyfiles": "2.4.1",
    "http-server": "14.1.1",
    "nodemon": "3.1.11",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.2",
    "postcss-cli": "11.0.1",
    "rimraf": "6.1.2",
    "rollup": "4.53.5",
    "sass": "1.85.1"
  }
}
